{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug TypeScript app",
      "type": "node",
      "request": "launch",
      // "program": "${workspaceFolder}/dist/variablesPractice.js",
      "program": "${workspaceFolderBasename}/dist/arrays.js",
      //"program": "${workspaceFolder}/dist/index.js",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "sourceMaps": true,
      "preLaunchTask": "tsc: build"
    }
  ]
}
